{
  "manifest_version": 3,
  "name": "Content Saver",
  "version": "1.0.0",
  "description": "Save and organize web page content in a structured format",
  "author": "Content Saver Extension",
  "permissions": [
    "storage",
    "contextMenus",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Content Saver"
  }
}

